{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Odin: Build Debug",
      "type": "shell",
      "command": "mkdir -p bin && odin build . -debug -out:bin/game",
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "problemMatcher": [],
      "presentation": {
        "reveal": "silent",
        "panel": "shared",
        "clear": true
      }
    },
    {
      "label": "Odin: Run Game",
      "type": "shell",
      "command": "mkdir -p bin && export GLFW_VIDEODRIVER=wayland && odin run . -debug -out:bin/game",
      "group": "test",
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "shared",
        "focus": false,
        "clear": true
      }
    }
  ]
}
